# Production: approved PostgreSQL pool URL. Never use real data in preview.
DATABASE_URL=postgresql://user:password@host:5432/enactus
APP_ORIGIN=http://localhost:3000
QR_SECRET=replace-with-at-least-32-random-bytes
# Development only: PGlite PostgreSQL stored in .local/db. NEVER enable on Vercel.
LOCAL_DATABASE=0
GEO_MAX_ACCURACY=100
GEO_MAX_AGE_SECONDS=30
