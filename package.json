{
  "name": "enactus-zhetysu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "owner:create": "tsx scripts/owner.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests docs *.ts *.json *.mjs README.md",
    "test:e2e:setup": "LOCAL_DATABASE=1 LOCAL_DATABASE_PATH=.local/e2e tsx scripts/e2e-setup.ts",
    "owner:recover": "tsx scripts/owner-recover.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:prune": "tsx scripts/prune.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@vercel/functions": "^3.11.3",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
